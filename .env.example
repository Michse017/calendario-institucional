# Copia este archivo como .env y ajusta los valores.
# El .env real NUNCA se sube al repositorio.

APP_NAME="Calendario Institucional"
APP_ENV=local
# Muestra los errores en pantalla y relaja la exigencia de HTTPS en la cookie.
# Debe ser false en cualquier despliegue real.
APP_DEBUG=true
# Subcarpeta desde la que se sirve la app. Vacío si está en la raíz del dominio.
APP_BASE_PATH=

# Muestra las cuentas de ejemplo en la pantalla de acceso. Solo para la demo.
APP_DEMO=true

DB_HOST=db
DB_PORT=3306
DB_NAME=calendario_demo
DB_USER=calendario
DB_PASS=cambiame
# Zona horaria de la base. UTC por defecto: la zona es una decisión de
# despliegue, no del código. Ejemplo para Colombia: -05:00
DB_TIMEZONE=+00:00

# Conexion cifrada con la base. Las bases gestionadas de la nube suelen
# exigirla y rechazan de plano una conexion en claro.
DB_SSL=false
# Verificar el nombre del servidor en el certificado. Muchos proveedores
# lo firman con su propia autoridad interna, que el contenedor no conoce,
# asi que la verificacion fallaria siempre. El trafico sigue cifrado.
DB_SSL_VERIFY=false
# Ruta a la autoridad certificadora, si el proveedor la publica.
DB_SSL_CA=

# Ponlo en true SOLO si hay un proxy de confianza delante (por ejemplo un
# balanceador). Si no, la cabecera X-Forwarded-For es falsificable y permitiría
# saltarse el límite de intentos de acceso.
TRUST_PROXY=false

# Token para que una tarea programada pueda reiniciar los datos de la demo.
# Genera uno largo y aleatorio: php -r "echo bin2hex(random_bytes(32));"
DEMO_RESET_TOKEN=
